# .env untuk deployment BoothPOS di Oracle Cloud Always Free VM, dipakai
# bersama ../../docker-compose.store.yml (bukan docker-compose.yml biasa,
# yang itu untuk dev lokal saja — lihat CLAUDE.md).
#
# Cara pakai:
#   cp deploy/oracle-cloud/.env.example .env
#   nano .env   # isi SEMUA nilai bertanda GANTI-INI di bawah
#
# Jangan commit berkas .env hasil isian ke git — berkas ini cuma template.

APP_NAME=BoothPOS
APP_ENV=production
# Biarkan kosong — docker/store/entrypoint.sh men-generate APP_KEY
# otomatis saat container pertama kali jalan, lalu menulis baliknya ke
# berkas .env ini sendiri (persisten lewat bind-mount di
# docker-compose.store.yml).
APP_KEY=
APP_DEBUG=false
# Domain DuckDNS kamu, HARUS https:// (Caddy yang urus sertifikatnya —
# lihat deploy/oracle-cloud/Caddyfile).
APP_URL=https://GANTI-INI.duckdns.org

# DB_HOST tetap nama service Compose ("mysql"), bukan 127.0.0.1/localhost.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=boothpos
DB_USERNAME=root
# WAJIB diganti — jangan pernah pakai kredensial dev
# ("boothpos_local_dev") di server publik.
DB_PASSWORD=GANTI-INI-password-kuat-acak

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local

MAIL_MAILER=array

# app:backup/app:restore (WBS 9.2) baca/tulis di sini. Harus SAMA PERSIS
# dengan bind-mount kiri di docker-compose.store.yml (default /mnt/backup)
# dan sudah dibuat dulu di VM: `sudo mkdir -p /mnt/backup`.
BACKUP_EXTERNAL_PATH=/mnt/backup

# 018-license-activation — isi dengan PUBLIC key yang kamu buat sendiri
# di langkah 6 panduan (docs/deploy-oracle-cloud.md). PRIVATE key
# pasangannya TIDAK PERNAH masuk ke berkas ini atau server manapun —
# simpan hanya di laptopmu.
LICENSE_PUBLIC_KEY=GANTI-INI-base64-public-key
