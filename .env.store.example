# Store-deployment .env template — copy this to .env at the repo root
# (`cp .env.store.example .env`) when running BoothPOS via
# `docker-compose.store.yml` on a real store machine
# (specs/016-docker-store-deployment/).
#
# NOT the same file as `.env.docker.example` (feature 015's DEV-ONLY
# Docker path) or the stock `.env.example` (defaults to SQLite, which
# this project cannot use — see CLAUDE.md). This file is for the
# production-shaped `docker/store/` image only.

APP_NAME=BoothPOS
APP_ENV=production
# Leave blank — docker/store/entrypoint.sh generates this on first boot
# if empty, exactly like feature 015's dev entrypoint (research.md R4).
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# DB_HOST is the Compose service name (`mysql`), not 127.0.0.1 — same
# reasoning as the dev path's .env.docker.example.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=boothpos
# CHANGE THESE before going live at a real store — these are placeholder
# values only. Do not reuse the dev path's well-known credentials here.
DB_USERNAME=root
DB_PASSWORD=change-me-before-real-use

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local

MAIL_MAILER=array

# app:backup/app:restore (WBS 9.2) write/read here — point this at the
# HOST path where a real, physically-removable external drive is
# mounted (research.md R5). docker-compose.store.yml bind-mounts this
# same path into the app container at /mnt/backup.
BACKUP_EXTERNAL_PATH=/mnt/backup

# 018-license-activation — CHANGE THIS before going live at a real
# store. Left unset, config/license.php falls back to a dev/demo-only
# public key (safe to leave as-is for local dev/testing, NOT for a real
# customer install) — set this to the real vendor public key before
# shipping. The matching PRIVATE key must never appear in this file or
# any customer's .env; it lives only in the vendor's own local
# environment, used via `php artisan license:generate` (research.md R5).
# LICENSE_PUBLIC_KEY=
