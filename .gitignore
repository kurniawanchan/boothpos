.DS_Store

# Laravel (added once the skeleton is bootstrapped)
/vendor
/node_modules
/public/hot
/public/storage
/public/build
/storage/*.key
/storage/app/*
!/storage/app/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
.env
.env.backup
.env.production
.env.testing
.env.testing.local
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode
/.zed

# 008-android-installer — native Gradle/Kotlin wrapper project.
# Build outputs, local Gradle caches, and Android Studio project files are
# excluded; the bundled runtime *binaries* (PHP/MariaDB/mysqldump/tar for
# arm64-v8a, research.md R1/R2/R5) are large native artifacts sourced or
# built outside this repo, not committed source — see android/README.md.
/android/.gradle
/android/.idea
/android/local.properties
/android/*.iml
/android/app/*.iml
/android/build
/android/app/build
/android/captures
/android/.cxx
/android/app/src/main/assets/runtime/
/android/app/src/main/assets/laravel/
