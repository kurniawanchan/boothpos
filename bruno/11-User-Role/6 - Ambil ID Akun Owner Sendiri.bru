meta {
  name: 6 - Ambil ID Akun Owner Sendiri
  type: http
  seq: 6
}

get {
  url: {{base_url}}/auth/me
  auth: none
}

headers {
  Authorization: Bearer {{owner_token}}
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("owner_user_id", res.body.id);
  }
}

tests {
  test("ambil id akun owner yang sedang login", function () {
    expect(res.status).to.equal(200);
  });
}
