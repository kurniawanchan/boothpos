meta {
  name: 2 - Impor Dry Run
  type: http
  seq: 2
}

post {
  url: {{base_url}}/imports/master-data
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{owner_token}}
}

body:multipart-form {
  file: @file(./contoh-impor-valid.xlsx)
  dry_run: true
}

tests {
  test("pratinjau tidak menulis data (F15.4)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.dry_run).to.equal(true);
    expect(res.body.applied).to.equal(false);
  });
}
