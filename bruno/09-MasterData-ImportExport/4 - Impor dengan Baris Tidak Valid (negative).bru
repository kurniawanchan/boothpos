meta {
  name: 4 - Impor dengan Baris Tidak Valid (negative)
  type: http
  seq: 4
}

post {
  url: {{base_url}}/imports/master-data
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{owner_token}}
}

body:multipart-form {
  file: @file(./contoh-impor-invalid.xlsx)
}

tests {
  test("ditolak 422 - satu baris tidak valid membatalkan SELURUH impor", function () {
    expect(res.status).to.equal(422);
    expect(res.body.applied).to.equal(false);
    expect(res.body.errors.length).to.be.above(0);
  });
}
