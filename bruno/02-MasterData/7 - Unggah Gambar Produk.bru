meta {
  name: 7 - Unggah Gambar Produk
  type: http
  seq: 7
}

post {
  url: {{base_url}}/products/{{product_id}}/image
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{owner_token}}
}

body:multipart-form {
  image: @file(./sample-image.jpg)
}

tests {
  test("gambar produk terunggah, image_path terisi", function () {
    expect(res.status).to.equal(200);
    expect(res.body.image_url).to.not.equal(null);
  });
}
