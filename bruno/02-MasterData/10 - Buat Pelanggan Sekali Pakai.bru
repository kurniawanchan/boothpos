meta {
  name: 10 - Buat Pelanggan Sekali Pakai
  type: http
  seq: 10
}

post {
  url: {{base_url}}/customers
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{cashier_token}}
}

body:json {
  {
    "name": "Pelanggan Sekali Pakai (akan dihapus)",
    "phone": "089999999999"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("throwaway_customer_id", res.body.id);
  }
}

tests {
  test("pelanggan sekali-pakai dibuat, tanpa order/preorder", function () {
    expect(res.status).to.equal(201);
  });
}
