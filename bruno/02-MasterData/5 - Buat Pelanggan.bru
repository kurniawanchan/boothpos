meta {
  name: 5 - Buat Pelanggan
  type: http
  seq: 5
}

post {
  url: {{base_url}}/customers
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{cashier_token}}
}

body:json {
  {
    "name": "Budi Santoso",
    "phone": "081234567890"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("customer_id", res.body.id);
  }
}

tests {
  test("pelanggan dibuat", function () {
    expect(res.status).to.equal(201);
  });
}
