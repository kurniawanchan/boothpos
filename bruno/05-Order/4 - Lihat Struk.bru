meta { name: 4 - Lihat Struk
  type: http
  seq: 4
}
get {
  url: {{base_url}}/orders/{{order_id}}/receipt
  auth: none
}
headers { Authorization: Bearer {{cashier_token}} }
tests {
  test("struk berisi item dan total", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items.length).to.be.above(0);
  });
}
