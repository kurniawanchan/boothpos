meta { name: 4 - Tandai Barang Tiba
  type: http
  seq: 4
}
patch {
  url: {{base_url}}/preorders/{{preorder_id}}/status
  body: json
  auth: none
}
headers { Authorization: Bearer {{owner_token}} }
body:json {
  { "status": "arrived" }
}
tests {
  test("status arrived, stok bertambah", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("arrived");
  });
}
