meta { name: 1 - Buat Preorder
  type: http
  seq: 1
}
post {
  url: {{base_url}}/preorders
  body: json
  auth: none
}
headers { Authorization: Bearer {{cashier_token}} }
body:json {
  {
    "customer_id": {{customer_id}},
    "fulfillment": "pickup",
    "items": [ { "variant_id": {{variant_id}}, "qty": 1 } ]
  }
}
script:post-response {
  if (res.status === 201) { bru.setVar("preorder_id", res.body.id); }
}
tests {
  test("preorder dibuat, stok TIDAK berkurang", function () {
    expect(res.status).to.equal(201);
    expect(res.body.status).to.equal("ordered");
  });
}
