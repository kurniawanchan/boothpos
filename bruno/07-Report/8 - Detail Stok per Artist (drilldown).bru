meta {
  name: 8 - Detail Stok per Artist (drilldown)
  type: http
  seq: 8
}

get {
  url: {{base_url}}/reports/stock-by-artist?artist_id={{artist_id}}
  auth: none
}

headers {
  Authorization: Bearer {{owner_token}}
}

tests {
  test("artist_id memicu detail level-varian, bukan ringkasan (009-ui-ux-refinements US7)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.variants).to.be.an("array");
    expect(res.body.artist_id).to.equal(bru.getVar("artist_id"));
  });
}
