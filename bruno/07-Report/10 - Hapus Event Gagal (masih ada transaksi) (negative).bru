meta {
  name: 10 - Hapus Event Gagal (masih ada transaksi) (negative)
  type: http
  seq: 10
}

delete {
  url: {{base_url}}/events/{{event_id}}
  auth: none
}

headers {
  Authorization: Bearer {{owner_token}}
}

tests {
  test("hapus event ditolak 409 karena sudah punya order/preorder (009-ui-ux-refinements US4)", function () {
    expect(res.status).to.equal(409);
  });
}
