meta { name: 1 - Buat Event
  type: http
  seq: 1
}
post {
  url: {{base_url}}/events
  body: json
  auth: none
}
headers { Authorization: Bearer {{owner_token}} }
body:json {
  {
    "name": "Comifuro 20",
    "location": "JIExpo Kemayoran",
    "start_date": "2026-10-24",
    "end_date": "2026-10-25"
  }
}
script:post-response {
  if (res.status === 201) { bru.setVar("event_id", res.body.id); }
}
tests {
  test("event dibuat berstatus draft", function () {
    expect(res.status).to.equal(201);
    expect(res.body.status).to.equal("draft");
  });
}
