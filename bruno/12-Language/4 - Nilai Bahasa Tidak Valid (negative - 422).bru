meta {
  name: 4 - Nilai Bahasa Tidak Valid (negative - 422)
  type: http
  seq: 4
}

put {
  url: {{base_url}}/auth/language
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{owner_token}}
}

body:json {
  {
    "language": "fr"
  }
}

tests {
  test("ditolak 422 - hanya id/en yang valid", function () {
    expect(res.status).to.equal(422);
  });
}
