meta {
  name: 5 - Kembalikan Owner ke Default (cleanup)
  type: http
  seq: 5
}

put {
  url: {{base_url}}/auth/language
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{owner_token}}
}

body:json {
  {
    "language": "en"
  }
}

tests {
  test("owner dikembalikan ke default en", function () {
    expect(res.status).to.equal(200);
    expect(res.body.language).to.equal("en");
  });
}
