meta {
  name: 3 - Kasir Tanpa Akses Menu Users Tetap Bisa Ganti Bahasa
  type: http
  seq: 3
}

put {
  url: {{base_url}}/auth/language
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{cashier_token}}
}

body:json {
  {
    "language": "id"
  }
}

tests {
  test("self-service - tidak digerbang canAccessMenu('users')", function () {
    expect(res.status).to.equal(200);
    expect(res.body.language).to.equal("id");
  });
}
