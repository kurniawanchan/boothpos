meta {
  name: 2 - Konfirmasi via Me
  type: http
  seq: 2
}

get {
  url: {{base_url}}/auth/me
  auth: none
}

headers {
  Authorization: Bearer {{owner_token}}
}

tests {
  test("GET /auth/me langsung mencerminkan bahasa baru tanpa login ulang", function () {
    expect(res.status).to.equal(200);
    expect(res.body.language).to.equal("en");
  });
}
