meta {
  name: 1 - Ganti Bahasa ke English
  type: http
  seq: 1
}

put {
  url: {{base_url}}/auth/language
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{owner_token}}
}

body:json {
  {
    "language": "en"
  }
}

tests {
  test("bahasa berubah ke en", function () {
    expect(res.status).to.equal(200);
    expect(res.body.language).to.equal("en");
  });
}
