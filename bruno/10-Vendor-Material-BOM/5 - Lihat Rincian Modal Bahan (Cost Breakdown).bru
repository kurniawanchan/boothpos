meta {
  name: 5 - Lihat Rincian Modal Bahan (Cost Breakdown)
  type: http
  seq: 5
}

get {
  url: {{base_url}}/variants/{{variant_id}}/cost-breakdown
  auth: none
}

headers {
  Authorization: Bearer {{owner_token}}
}

tests {
  test("bom_cost dihitung dari qty_needed x harga vendor preferred, cost_price tidak berubah", function () {
    expect(res.status).to.equal(200);
    expect(res.body.bom_cost).to.equal("10000.00");
    expect(res.body).to.have.property("cost_price");
  });
}
