meta {
  name: 1 - Buat Vendor
  type: http
  seq: 1
}

post {
  url: {{base_url}}/vendors
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{owner_token}}
}

body:json {
  {
    "code": "VNDBRN",
    "name": "Toko Bahan Bruno"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("vendor_id", res.body.id);
  }
}

tests {
  test("vendor dibuat", function () {
    expect(res.status).to.equal(201);
    expect(res.body.code).to.equal("VNDBRN");
  });
}
