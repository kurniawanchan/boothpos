get {
  url: {{base_url}}/auth/me
  auth: none
}

headers {
  Authorization: Bearer {{owner_token}}
}

tests {
  test("mengembalikan profil owner", function () {
    expect(res.status).to.equal(200);
    expect(res.body.role).to.equal("owner");
  });
}
