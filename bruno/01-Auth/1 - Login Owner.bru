meta {
  name: 1 - Login Owner
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "owner",
    "password": "password123"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("owner_token", res.body.token);
  }
}

tests {
  test("login berhasil", function () {
    expect(res.status).to.equal(200);
    expect(res.body.token).to.be.a("string");
  });
}
