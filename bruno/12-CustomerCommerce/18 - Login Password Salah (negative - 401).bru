meta {
  name: 18 - Login Password Salah (negative - 401)
  type: http
  seq: 18
}

post {
  url: {{base_url}}/customer/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{customer_email}}",
    "password": "password-salah-bruno"
  }
}

script:post-response {
  // Disimpan tanpa request_id untuk dibandingkan dengan login e-mail tidak terdaftar (request 19).
  if (res.status === 401) {
    const salinan = Object.assign({}, res.body);
    delete salinan.request_id;
    bru.setVar("invalid_credentials_body", JSON.stringify(salinan));
  }
}

tests {
  test("ditolak 401 invalid_credentials - pesan generik", function () {
    expect(res.status).to.equal(401);
    expect(res.body.code).to.equal("invalid_credentials");
    expect(res.body.request_id).to.be.a("string");
    expect(res.body).to.not.have.property("errors");
  });
}
