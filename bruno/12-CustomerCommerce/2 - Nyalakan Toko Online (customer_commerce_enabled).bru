meta {
  name: 2 - Nyalakan Toko Online (customer_commerce_enabled)
  type: http
  seq: 2
}

put {
  url: {{base_url}}/settings
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{owner_token}}
}

body:json {
  {
    "settings": [
      { "key": "customer_commerce_enabled", "value": true, "type": "boolean", "group": "customer_commerce" }
    ]
  }
}

tests {
  test("saklar toko online tersimpan lewat endpoint pengaturan staf", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data[0].key).to.equal("customer_commerce_enabled");
  });
}
