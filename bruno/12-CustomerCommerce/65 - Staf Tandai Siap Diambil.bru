meta {
  name: 65 - Staf Tandai Siap Diambil
  type: http
  seq: 65
}

post {
  url: {{base_url}}/customer-orders/{{customer_pickup_order_staff_id}}/ready
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{owner_token}}
}

body:json {
  {
    "note": "Silakan ambil di booth."
  }
}

tests {
  test("status berpindah ke ready_for_pickup", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("ready_for_pickup");
  });
}
