meta {
  name: 28 - Daftar Alamat Pelanggan A
  type: http
  seq: 28
}

get {
  url: {{base_url}}/customer/addresses
  auth: none
}

headers {
  Authorization: Bearer {{customer_token}}
}

tests {
  test("hanya alamat milik akun ini, alamat utama di depan", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.have.length(1);
    expect(Number(res.body.data[0].id)).to.equal(Number(bru.getVar("customer_address_id")));
    expect(res.body.data[0].is_default).to.equal(true);
  });
}
