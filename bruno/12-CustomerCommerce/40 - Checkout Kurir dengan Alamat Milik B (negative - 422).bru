meta {
  name: 40 - Checkout Kurir dengan Alamat Milik B (negative - 422)
  type: http
  seq: 40
}

post {
  url: {{base_url}}/customer/orders
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{customer_token}}
  Idempotency-Key: {{foreign_address_idempotency_key}}
}

body:json {
  {
    "fulfilment_method": "courier",
    "address_id": {{customer_b_address_id}},
    "items": [
      { "variant_id": {{storefront_variant_id}}, "qty": 1 }
    ],
    "expected_total": "{{storefront_variant_price}}"
  }
}

script:pre-request {
  function uuidv4() {
    return "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, function (c) {
      const r = Math.random() * 16 | 0;
      const v = c === "x" ? r : (r & 0x3 | 0x8);
      return v.toString(16);
    });
  }
  bru.setVar("foreign_address_idempotency_key", uuidv4());
}

tests {
  test("ditolak 422 validation_failed pada errors.address_id - alamat akun lain tidak bisa dipakai", function () {
    expect(res.status).to.equal(422);
    expect(res.body.code).to.equal("validation_failed");
    expect(res.body.errors.address_id).to.be.an("array");
  });
}
