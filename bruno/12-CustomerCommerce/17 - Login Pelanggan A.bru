meta {
  name: 17 - Login Pelanggan A
  type: http
  seq: 17
}

post {
  url: {{base_url}}/customer/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{customer_email}}",
    "password": "{{customer_password}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("customer_token", res.body.token);
  }
}

tests {
  test("login berhasil dengan token pelanggan berumur terbatas", function () {
    expect(res.status).to.equal(200);
    expect(res.body.token).to.be.a("string");
    expect(res.body.expires_at).to.be.a("string");
    expect(res.body.account.email).to.equal(bru.getVar("customer_email"));
  });
}
