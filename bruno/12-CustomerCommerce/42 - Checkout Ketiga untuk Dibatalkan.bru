meta {
  name: 42 - Checkout Ketiga untuk Dibatalkan
  type: http
  seq: 42
}

post {
  url: {{base_url}}/customer/orders
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{customer_token}}
  Idempotency-Key: {{cancel_idempotency_key}}
}

body:json {
  {
    "fulfilment_method": "pickup",
    "items": [
      { "variant_id": {{storefront_variant_id}}, "qty": 1 }
    ],
    "notes": "Pesanan uji untuk dibatalkan toko.",
    "expected_total": "{{storefront_variant_price}}"
  }
}

script:pre-request {
  function uuidv4() {
    return "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, function (c) {
      const r = Math.random() * 16 | 0;
      const v = c === "x" ? r : (r & 0x3 | 0x8);
      return v.toString(16);
    });
  }
  bru.setVar("cancel_idempotency_key", uuidv4());
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("customer_cancel_order_number", res.body.data.order_number);
  }
}

tests {
  test("pesanan ketiga dibuat dan menunggu konfirmasi", function () {
    expect(res.status).to.equal(201);
    expect(res.body.data.status).to.equal("awaiting_confirmation");
  });
}
