meta {
  name: 15 - Registrasi Pelanggan A
  type: http
  seq: 15
}

post {
  url: {{base_url}}/customer/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Pelanggan Bruno A",
    "email": "{{customer_email}}",
    "password": "{{customer_password}}",
    "phone": "080000000001"
  }
}

script:pre-request {
  // E-mail unik per run dengan TLD .test (dicadangkan): bukan alamat sungguhan, tidak ada surel terkirim.
  bru.setVar("customer_email", "bruno.cust+" + Date.now() + "@example.test");
}

script:post-response {
  // Token registrasi langsung bisa dipakai; request 17 menggantinya dengan token hasil login.
  if (res.status === 201) {
    bru.setVar("customer_token", res.body.token);
  }
}

tests {
  test("akun dibuat dan langsung mendapat token pelanggan", function () {
    expect(res.status).to.equal(201);
    expect(res.body.token).to.be.a("string");
    expect(res.body.token_type).to.equal("Bearer");
    expect(res.body.expires_at).to.be.a("string");
    expect(res.body.account.email).to.equal(bru.getVar("customer_email"));
    expect(res.body.account.email_verified).to.equal(false);
    expect(res.body.account).to.not.have.property("password");
  });
}
