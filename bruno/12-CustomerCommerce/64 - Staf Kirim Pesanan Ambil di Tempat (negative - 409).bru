meta {
  name: 64 - Staf Kirim Pesanan Ambil di Tempat (negative - 409)
  type: http
  seq: 64
}

post {
  url: {{base_url}}/customer-orders/{{customer_pickup_order_staff_id}}/ship
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{owner_token}}
}

body:json {
  {
    "courier_name": "JNE",
    "tracking_number": "BRUNO-SALAH-METODE"
  }
}

tests {
  test("ditolak 409 wrong_fulfilment_method - pesanan ambil di tempat tidak dikirim lewat kurir", function () {
    expect(res.status).to.equal(409);
    expect(res.body.code).to.equal("wrong_fulfilment_method");
  });
}
