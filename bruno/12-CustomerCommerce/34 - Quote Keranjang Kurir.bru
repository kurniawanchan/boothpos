meta {
  name: 34 - Quote Keranjang Kurir
  type: http
  seq: 34
}

post {
  url: {{base_url}}/customer/orders/quote
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{customer_token}}
}

body:json {
  {
    "fulfilment_method": "courier",
    "address_id": {{customer_address_id}},
    "items": [
      { "variant_id": {{storefront_variant_id}}, "qty": 2 }
    ]
  }
}

script:post-response {
  // Total dari server inilah yang dikirim aplikasi sebagai expected_total saat checkout (request 36).
  if (res.status === 200) {
    bru.setVar("quote_total", res.body.data.total);
  }
}

tests {
  test("harga dihitung server; ongkir kurir menunggu konfirmasi toko", function () {
    expect(res.status).to.equal(200);
    const q = res.body.data;
    expect(q.fulfilment_method).to.equal("courier");
    expect(q.lines[0].qty).to.equal(2);
    expect(q.lines[0].unit_price).to.equal("75000.00");
    expect(q.lines[0].product_slug).to.equal(bru.getVar("storefront_product_slug"));
    expect(q.subtotal).to.equal("150000.00");
    expect(q.shipping_cost).to.equal("0.00");
    expect(q.shipping_cost_pending).to.equal(true);
    expect(q.total).to.equal(q.subtotal);
  });
}
