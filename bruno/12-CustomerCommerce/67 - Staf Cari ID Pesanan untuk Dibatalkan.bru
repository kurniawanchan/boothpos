meta {
  name: 67 - Staf Cari ID Pesanan untuk Dibatalkan
  type: http
  seq: 67
}

get {
  url: {{base_url}}/customer-orders?q={{customer_cancel_order_number}}
  auth: none
}

headers {
  Authorization: Bearer {{owner_token}}
}

script:post-response {
  // Rute staf memakai id numerik; pelanggan hanya mengenal order_number. Id dicari lewat ?q=.
  if (res.status === 200) {
    const pesanan = (res.body.data || []).find(function (o) {
      return o.order_number === bru.getVar("customer_cancel_order_number");
    });
    bru.setVar("customer_cancel_order_staff_id", pesanan ? pesanan.id : "");
  }
}

tests {
  test("pesanan ketiga tampil di daftar staf dan masih menunggu konfirmasi", function () {
    expect(res.status).to.equal(200);
    const pesanan = res.body.data.find(function (o) {
      return o.order_number === bru.getVar("customer_cancel_order_number");
    });
    expect(pesanan, "pesanan tidak ditemukan").to.be.an("object");
    expect(pesanan.status).to.equal("awaiting_confirmation");
  });
}
