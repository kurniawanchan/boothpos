meta {
  name: 9 - Terbitkan Produk Etalase dengan Variannya
  type: http
  seq: 9
}

post {
  url: {{base_url}}/products/{{storefront_product_id}}/publish
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{owner_token}}
}

body:json {
  {
    "with_variants": true
  }
}

tests {
  test("produk dan KEDUA varian terbit, termasuk varian yang stoknya nol", function () {
    expect(res.status).to.equal(200);
    expect(res.body.published_at).to.be.a("string");
    expect(res.body.slug).to.equal(bru.getVar("storefront_product_slug"));
    expect(res.body.variants).to.have.length(2);
    res.body.variants.forEach(function (v) {
      expect(v.published_at, v.variant_name).to.be.a("string");
    });
  });
}
