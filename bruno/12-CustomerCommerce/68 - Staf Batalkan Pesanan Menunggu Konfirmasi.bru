meta {
  name: 68 - Staf Batalkan Pesanan Menunggu Konfirmasi
  type: http
  seq: 68
}

post {
  url: {{base_url}}/customer-orders/{{customer_cancel_order_staff_id}}/cancel
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{owner_token}}
}

body:json {
  {
    "reason": "{{customer_cancel_reason}}"
  }
}

script:pre-request {
  // Alasan pembatalan dilihat pelanggan (request 69), jadi teks biasa tanpa data pribadi.
  bru.setVar("customer_cancel_reason", "Stok dialokasikan untuk acara lain.");
}

tests {
  test("dibatalkan dengan alasan yang dilihat pelanggan", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("cancelled");
    expect(res.body.data.cancel_reason).to.equal(bru.getVar("customer_cancel_reason"));
  });
  test("batal sebelum konfirmasi tidak menggerakkan stok (tetap 7)", function () {
    expect(res.body.data.stock_deducted_at).to.equal(null);
    expect(res.body.data.items[0].available_stock).to.equal(7);
  });
}
