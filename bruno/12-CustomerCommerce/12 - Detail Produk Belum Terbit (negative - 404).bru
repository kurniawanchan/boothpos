meta {
  name: 12 - Detail Produk Belum Terbit (negative - 404)
  type: http
  seq: 12
}

get {
  url: {{base_url}}/storefront/products/{{hidden_product_slug}}
  auth: none
}

tests {
  test("ditolak 404 not_found - produk yang ada tetapi belum terbit tidak terlihat publik", function () {
    expect(res.status).to.equal(404);
    expect(res.body.code).to.equal("not_found");
    expect(res.getHeader("content-type")).to.include("application/problem+json");
  });
}
