# Docker-path .env template — copy this to .env at the repo root
# (`cp .env.docker.example .env`) when running BoothPOS via
# `docker compose up` (specs/015-dockerize-dev-environment).
#
# This is NOT the same file as the stock `.env.example` shipped by
# Laravel: that file still defaults to DB_CONNECTION=sqlite, which
# directly contradicts this project's MySQL-only rule (see CLAUDE.md
# and research.md R8) and would hard-fail on the first migration that
# uses a raw MySQL-only CHECK constraint. Use THIS file for the Docker
# path, not that one.
#
# For the native (non-Docker) path, continue using your own .env
# pointed at 127.0.0.1 and the laradock-mysql-1 container, as documented
# in CLAUDE.md.

APP_NAME=BoothPOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# DB_HOST is the Compose service name (`mysql`), not 127.0.0.1 — inside
# Docker, containers reach each other by service name over the Compose
# network, not localhost (research.md R1/R4).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=boothpos
# Dev-only credentials, never used outside a local Docker Compose
# network. Do not reuse these for anything internet-reachable.
DB_USERNAME=root
DB_PASSWORD=boothpos_local_dev

# BUG YANG DITEMUKAN & DIPERBAIKI (015-dockerize-dev-environment) —
# draf awal file ini memakai SESSION_DRIVER=array, yang TIDAK
# mempertahankan sesi antar request sama sekali (login langsung
# "logout" lagi di request berikutnya, karena driver array cuma hidup
# selama satu request lalu dibuang) — fatal untuk auth Sanctum yang
# stateful (cookie-session) di app ini. Disamakan dengan `file` yang
# sudah dipakai .env asli (bukan `database`, karena tabel `sessions`
# Laravel tidak ada di migration project ini).
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local

MAIL_MAILER=array

# Frontend dev-server -> backend proxy target (research.md R6). The
# `node` Compose service sets this to reach the `app` service by name;
# it has no effect unless resources/js is served via the `node`
# container's `npm run dev`.
VITE_API_PROXY_TARGET=http://app:8000
