<?xml version="1.0" encoding="utf-8"?>
<!-- Rilis: lalu lintas teks biasa dilarang dan hanya CA sistem yang dipercaya (bukan CA pasangan pengguna). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
