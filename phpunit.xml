<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
        BUG DITEMUKAN (020-customer-data-import-export, verifikasi manual
        Constitution II) — TIDAK SEPENUHNYA TERTUTUP oleh force="true" di
        bawah ini, dicatat di sini sebagai peringatan sampai ada perbaikan
        permanen di docker-compose.yml. docker-compose.yml service `app`
        memakai `env_file: .env`, yang menyuntikkan APP_ENV=local dan
        DB_DATABASE=boothpos (database DEV SUNGGUHAN) sebagai environment
        variable level-OS DI DALAM CONTAINER — lapisan yang lebih dalam
        daripada apa pun yang bisa disentuh dari userland PHP. `force`
        PHPUnit di sini TERBUKTI TIDAK CUKUP (diverifikasi langsung: env
        tetap 'local', DB tetap 'boothpos' walau force="true" dipasang).
        Akibatnya, di lingkungan Docker (BUKAN native), `docker compose
        exec app php artisan test` diam-diam berjalan melawan `boothpos`
        (database dev asli) dan RefreshDatabase MENGHAPUS seluruh data
        dev/demo di sana tanpa satu pun error terlihat.

        SATU-SATUNYA workaround yang terbukti benar-benar bekerja (lihat
        docs/RUNBOOK.md): override eksplisit di level `docker compose
        exec`, BUKAN lewat berkas ini:
          docker compose exec -e APP_ENV=testing -e DB_DATABASE=boothpos_test app php artisan test
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
        DB_* diserahkan ke .env.testing (tidak dikomit), BUKAN dipaksa ke
        sqlite di sini. Dua migration (orders_and_payments, preorders)
        memakai DB::statement('ALTER TABLE ... ADD CONSTRAINT ... CHECK')
        yang sintaksnya MySQL-only — bila dipaksa sqlite di sini,
        env('DB_CONNECTION') dari .env.testing tidak akan pernah terbaca
        (Dotenv tidak menimpa env var yang sudah di-set oleh phpunit.xml),
        dan test akan gagal saat migrate karena sqlite tidak mengerti
        sintaks CHECK constraint MySQL. Test WAJIB jalan lewat MySQL nyata.
        -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
